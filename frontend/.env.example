# Copy to `.env.local` and adjust if the UI shows "Cannot reach API".

# Docker: backend/docker-compose.yml maps API to host port 8001 (container 8000).
# Bare uvicorn on the host usually uses 8000.
#
# When NEXT_PUBLIC_API_URL is unset, the browser calls /api/* on the Next.js dev server,
# which proxies to this URL (see next.config.ts rewrites).
BACKEND_INTERNAL_URL=http://127.0.0.1:8001

# Optional: browser calls the API host directly (needs CORS; backend allows *).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
