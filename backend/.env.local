# ── Local development config ─────────────────────────────────
# Copy this over .env to run against the local Docker Postgres:
#   cp .env.local .env
#   docker-compose --profile local up -d
#   alembic upgrade head
#
# DATABASE_URL uses port 5433 on the host (see docker-compose.yml port map).

DATABASE_URL=postgresql+asyncpg://admin:localpassword@localhost:5433/quotation_system
DATABASE_URL_SYNC=postgresql://admin:localpassword@localhost:5433/quotation_system
# For local dev Alembic can use the same connection as sync.
DATABASE_URL_DIRECT=postgresql://admin:localpassword@localhost:5433/quotation_system

# Supabase API (unused locally — left blank)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (LiteLLM)
LITELLM_MODEL=gemini/gemini-2.5-pro
ANTHROPIC_API_KEY=AIzaSyBBAgql4_ZsKqg3BVE3D2FSMyWBuzpaYZA

# App
APP_ENV=development
ACTIVE_CLIENT=parth_valves
CONFIDENCE_THRESHOLD=0.85
LOG_LEVEL=INFO

EMAIL_ADDRESS=aaditya.choubey@clevrscan.com
EMAIL_APP_PASSWORD=ngzl kxen amls wwji
EMAIL_SYNC_ENABLED=true
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SYNC_INTERVAL_SECONDS=120
EMAIL_SYNC_LABEL=INBOX
EMAIL_FILTER_UNREAD_ONLY=true
EMAIL_ENQUIRY_KEYWORDS=valve,hose,fitting,quotation,quote,inquiry,enquiry,butterfly,requirement,price,supply

# PDF
PDF_OUTPUT_DIR=./output/pdfs
