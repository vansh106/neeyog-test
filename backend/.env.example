# ── Database ─────────────────────────────────────────────────
# DATABASE_URL — async connection used by FastAPI (asyncpg).
# For Supabase, use the transaction pooler (port 6543).
# MUST include the +asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# DATABASE_URL_SYNC — sync connection (psycopg2) for background jobs.
# For Supabase, use the session pooler (port 5432 on the pooler host).
DATABASE_URL_SYNC=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# DATABASE_URL_DIRECT — direct-to-DB connection (port 5432 on db.<ref>).
# Alembic uses this because PgBouncer (transaction mode) cannot run DDL.
DATABASE_URL_DIRECT=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase API (optional unless using Auth/Storage/Realtime) ──
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Local-only example (copy from .env.local) ───────────────
# DATABASE_URL=postgresql+asyncpg://admin:localpassword@localhost:5433/quotation_system
# DATABASE_URL_SYNC=postgresql://admin:localpassword@localhost:5433/quotation_system
# DATABASE_URL_DIRECT=postgresql://admin:localpassword@localhost:5433/quotation_system

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (LiteLLM) — set the key that matches your LITELLM_MODEL
LITELLM_MODEL=gemini/gemini-2.5-pro
GEMINI_API_KEY=your_google_ai_studio_key
ANTHROPIC_API_KEY=sk-ant-optional-if-using-claude

# App
APP_ENV=development
ACTIVE_CLIENT=parth_valves
CONFIDENCE_THRESHOLD=0.85
LOG_LEVEL=INFO

# PDF
PDF_OUTPUT_DIR=./output/pdfs

# Timeouts (seconds)
LLM_REQUEST_TIMEOUT_SECONDS=180
ENQUIRY_FLOW_TIMEOUT_SECONDS=900

# Gmail IMAP Sync
EMAIL_SYNC_ENABLED=true
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# Sync behaviour
EMAIL_SYNC_INTERVAL_SECONDS=120
EMAIL_SYNC_LABEL=INBOX
EMAIL_FILTER_UNREAD_ONLY=true

EMAIL_ENQUIRY_KEYWORDS=valve,hose,fitting,quotation,quote,inquiry,enquiry,butterfly,requirement,price,supply
