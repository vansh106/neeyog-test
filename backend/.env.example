# Database (host dev: localhost:5433 maps to postgres container)
# Docker Compose `api` service overrides DATABASE_* / REDIS_URL to postgres:5432 and redis:6379
DATABASE_URL=postgresql+asyncpg://admin:localpassword@localhost:5433/quotation_system
DATABASE_URL_SYNC=postgresql://admin:localpassword@localhost:5433/quotation_system

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (LiteLLM) — set the key that matches your LITELLM_MODEL
# Gemini / Google AI: use GEMINI_API_KEY (or temporarily put the same key in ANTHROPIC_API_KEY; code maps it)
# Anthropic Claude: use ANTHROPIC_API_KEY and a model like anthropic/claude-sonnet-4-20250514
LITELLM_MODEL=gemini/gemini-2.5-pro
GEMINI_API_KEY=your_google_ai_studio_key
ANTHROPIC_API_KEY=sk-ant-optional-if-using-claude

# App
APP_ENV=development
ACTIVE_CLIENT=parth_valves
CONFIDENCE_THRESHOLD=0.85
LOG_LEVEL=INFO

# PDF
PDF_OUTPUT_DIR=./output/pdfs

# Timeouts (seconds) — prevents hung HTTP requests / Postman “endless” spinners
LLM_REQUEST_TIMEOUT_SECONDS=180
ENQUIRY_FLOW_TIMEOUT_SECONDS=900

# Gmail IMAP Sync
EMAIL_SYNC_ENABLED=true
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# Sync behaviour
EMAIL_SYNC_INTERVAL_SECONDS=120
EMAIL_SYNC_LABEL=INBOX
EMAIL_FILTER_UNREAD_ONLY=true

# Keywords to identify enquiry emails (comma-separated; ANY match in subject or body)
EMAIL_ENQUIRY_KEYWORDS=valve,hose,fitting,quotation,quote,inquiry,enquiry,butterfly,requirement,price,supply

# First successful sync creates a baseline: existing UNSEEN mail is skipped (not parsed) and marked read.
# Only mail that is still unread after that, or newly arrives, is eligible for enquiry parsing.
