# ── Database — Supabase ───────────────────────────────────────
# Async URL used by FastAPI (asyncpg). MUST include the +asyncpg driver
# suffix — otherwise SQLAlchemy falls back to psycopg2.
# Uses the transaction pooler (port 6543) for best concurrency.
DATABASE_URL=postgresql+asyncpg://postgres.khymmynqeecqbmdfzlap:3rJ2Pvi%2AMVp3s%40q@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

DATABASE_URL_SYNC=postgresql://postgres.khymmynqeecqbmdfzlap:3rJ2Pvi%2AMVp3s%40q@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Direct host (db.*.supabase.co) is IPv6-only — often unreachable from local Mac.
# Use session pooler on port 5432 for Alembic migrations (supports DDL).
DATABASE_URL_DIRECT=postgresql://postgres.khymmynqeecqbmdfzlap:3rJ2Pvi%2AMVp3s%40q@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
