# ── Database — Supabase ───────────────────────────────────────
# Async URL used by FastAPI (asyncpg). MUST include the +asyncpg driver
# suffix — otherwise SQLAlchemy falls back to psycopg2.
# Uses the transaction pooler (port 6543) for best concurrency.
DATABASE_URL=postgresql+asyncpg://postgres.znvawoccpqgxlpavlmxk:aaditya981100%23@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

DATABASE_URL_SYNC=postgresql://postgres.znvawoccpqgxlpavlmxk:aaditya981100%23@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Session pooler on port 5432 for Alembic migrations (supports DDL; works from Docker).
DATABASE_URL_DIRECT=postgresql://postgres.znvawoccpqgxlpavlmxk:aaditya981100%23@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Dedicated schema so CPQ tables do not collide with other apps in `public`.
DB_SCHEMA=xyz_traders
